# Copy this file to inventory.yaml and fill in your real device details.
# inventory.yaml itself is gitignored (see .gitignore fix #10) so real
# device IPs never end up committed again.

devices:
  - name: "cp_member_1"
    role: "cp-cluster-member"
    ip: "203.0.113.10"          # RFC 5737 placeholder -- replace with real IP
    login: "admin"
    password_env_var: "CHECKPOINT_DEVICE1_PASSWORD"
    expert_password_env_var: "CHECKPOINT_DEVICE1_EXPERT_PASSWORD"
    ssh_key_path: "~/.ssh/id_rsa"

  - name: "cp_member_2"
    role: "cp-cluster-member"
    ip: "203.0.113.11"
    login: "admin"
    password_env_var: "CHECKPOINT_DEVICE2_PASSWORD"
    expert_password_env_var: "CHECKPOINT_DEVICE2_EXPERT_PASSWORD"
    ssh_key_path: "~/.ssh/id_rsa"

  - name: "aruba_vsx_node"
    role: "aruba-vsx-node"
    ip: "203.0.113.20"
    login: "admin"
    password_env_var: "ARUBA_DEVICE1_PASSWORD"
    ssh_key_path: "~/.ssh/id_aruba"

  # Add more devices here as needed...